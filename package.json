{
  "name": "@gismo2026/sdk",
  "version": "1.0.1",
  "description": "Generated TypeScript client for the Gismo Control-Plane API and MCP tool-surface models",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axemere-LLC/gismo-sdk-typescript.git"
  },
  "homepage": "https://github.com/Axemere-LLC/gismo-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/Axemere-LLC/gismo-sdk-typescript/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "scripts/generate.sh",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2"
  }
}
